{
  "name": "zundamons-kitchen-v2",
  "version": "1.0.0",
  "description": "Clean, structured transfer of Zundamon's kItchen",
  "private": true,
  "scripts": {
    "lint": "npm run lint:stylua && npm run lint:selene",
    "lint:stylua": "stylua --check src",
    "lint:selene": "selene --allow-warnings src",
    "format": "stylua src",
    "check": "npm run lint && npm run rojo:build",
    "rojo:build": "rojo build default.project.json -o build/ZundamonsKitchen.rbxl",
    "rojo:sourcemap": "rojo sourcemap default.project.json -o build/sourcemap.json",
    "rojo:serve": "rojo serve default.project.json",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@johnnymorganz/stylua-bin": "2.5.2",
    "rojo": "1.0.3-rojo7.6.1"
  },
  "dependencies": {
    "jsdom": "^29.1.1"
  }
}
