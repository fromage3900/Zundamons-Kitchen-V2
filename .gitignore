# Generated Zundamon VO audio. Regenerable from voiceline_manifest.py via
# voicevox_voiceline_worker.py, so the ~5MB of renders stays out of git.
# manifest.json IS tracked — it carries the Roblox asset IDs, which are the
# only part that cannot be regenerated.
scripts/voicevox_output/*.wav
scripts/voicevox_output/*.mp3
